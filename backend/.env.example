MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=6000

# Brevo (https://app.brevo.com) transactional email API key
BREVO_API_KEY=
# Sender identity — must be a verified sender/domain in your Brevo account
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Salon

# Used to build links inside transactional emails (verification, password reset, etc.)
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRY_HOURS=24
